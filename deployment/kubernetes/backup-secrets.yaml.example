# This is an example file. Rename to backup-secrets.yaml and fill in actual sensitive values.
# Apply this manifest to your Kubernetes cluster after updating the values.
# Ensure sensitive values are base64 encoded when creating secrets directly with kubectl,
# or use stringData for unencoded values when applying YAML like this.

apiVersion: v1
kind: Secret
metadata:
  name: rag-pipeline-backup-db-credentials
  namespace: rag-pipeline # Ensure this matches your application's namespace
type: Opaque
stringData: # Using stringData for readability; K8s will encode it.
  # Example for PostgreSQL. Adjust or add for other databases if BackupManager is extended.
  # This DB_URL_FOR_BACKUP will be used by the run_backup_job.py script.
  DB_URL_FOR_BACKUP: "postgresql://your_backup_user:your_backup_password@your_postgres_host.your_namespace.svc.cluster.local:5432/your_database_name"
  # For Qdrant, if it uses an API key for operations including snapshots:
  # QDRANT_API_KEY_FOR_BACKUP: "your-qdrant-api-key" # Uncomment and set if Qdrant requires an API key for snapshots

---
apiVersion: v1
kind: Secret
metadata:
  name: rag-pipeline-backup-s3-credentials
  namespace: rag-pipeline # Ensure this matches your application's namespace
type: Opaque
stringData:
  # These will be used by run_backup_job.py if S3 backups are enabled.
  # Ensure the IAM user associated with these keys has appropriate permissions for the S3 bucket.
  AWS_ACCESS_KEY_ID_FOR_BACKUP: "YOUR_AWS_ACCESS_KEY_ID"
  AWS_SECRET_ACCESS_KEY_FOR_BACKUP: "YOUR_AWS_SECRET_ACCESS_KEY"
---
